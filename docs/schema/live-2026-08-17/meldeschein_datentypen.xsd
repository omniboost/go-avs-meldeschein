	<xsd:simpleType name="sName">
		<xsd:restriction base="xsd:string">
			<xsd:maxLength value="50"/>
		</xsd:restriction>
	</xsd:simpleType>

	<xsd:simpleType name="sStrasse">
		<xsd:restriction base="xsd:string">
			<xsd:maxLength value="50"/>
		</xsd:restriction>
	</xsd:simpleType>

	<xsd:simpleType name="sHausnummer">
		<xsd:restriction base="xsd:string">
			<xsd:maxLength value="50"/>
		</xsd:restriction>
	</xsd:simpleType>

	<xsd:simpleType name="sPlz">
		<xsd:restriction base="xsd:string">
			<xsd:maxLength value="10"/></xsd:restriction>
	</xsd:simpleType>

	<xsd:simpleType name="sOrt">
		<xsd:restriction base="xsd:string">
			<xsd:maxLength value="50"/>
		</xsd:restriction>
	</xsd:simpleType>

	<xsd:simpleType name="sPostfach">
		<xsd:restriction base="xsd:string">
			<xsd:maxLength value="10"/>
		</xsd:restriction>
	</xsd:simpleType>

	<xsd:simpleType name="sPostfachPlz">
		<xsd:restriction base="xsd:string">
			<xsd:maxLength value="10"/>
			<xsd:pattern value="[0-9]*"/>
		</xsd:restriction>
	</xsd:simpleType>


	<xsd:simpleType name="sAnschlusskennung">
	<!-- Telefonnummer; eMail -->
		<xsd:restriction base="xsd:string">
			<xsd:maxLength value="50"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="sAnschlussTypId">
	<!-- Typ der Kommunikationsverbindung : todo: gemappter Tabellenwert ?? -->
		<xsd:restriction base="xsd:long">
		</xsd:restriction>
	</xsd:simpleType>

	<xsd:simpleType name="sZahlartId">
	<!-- ID der Zahlart 1 (Ueberweisung) oder 2 ( Bankeinzug) -->
		<xsd:restriction base="xsd:long">
			<xsd:minInclusive value="1"/>
			<xsd:maxInclusive value="2"/>
		</xsd:restriction>
	</xsd:simpleType>

	<xsd:simpleType name="sBankverbindung">
	<!-- Name des Kreditinstitutes -->
		<xsd:restriction base="xsd:string">
			<xsd:maxLength value="255"/>
		</xsd:restriction>
	</xsd:simpleType>

	<xsd:simpleType name="sKontonummer">
		<xsd:restriction base="xsd:string">
			<xsd:maxLength value="15"/>
			<xsd:pattern value="[0-9]*"/>
		</xsd:restriction>
	</xsd:simpleType>

	<xsd:simpleType name="sBankleitzahl">
		<xsd:restriction base="xsd:string">
			<xsd:maxLength value="15"/>
			<xsd:pattern value="[0-9]*"/>
		</xsd:restriction>
	</xsd:simpleType>

	<xsd:simpleType name="Provision">
		<xsd:restriction base="xsd:decimal">
			<xsd:pattern value="([0-9]{1,4}).([0-9]{1,2})"/>
		</xsd:restriction>
	</xsd:simpleType>

	<xsd:simpleType name="sKontoinhaber">
	<!-- Name des Kontoinhabers -->
		<xsd:restriction base="xsd:string">
			<xsd:maxLength value="100"/>
		</xsd:restriction>
	</xsd:simpleType>

	<xsd:simpleType name="sBezeichnung">
	<!-- Name des Hotels -->
		<xsd:restriction base="xsd:string">
			<xsd:minLength value="3"/>
			<xsd:maxLength value="255"/>
		</xsd:restriction>
	</xsd:simpleType>

	<xsd:simpleType name="sKurtaxzoneId">
	<!-- von uns gelieferter Wertebereich -->
		<xsd:restriction base="xsd:long"/>
	</xsd:simpleType>

	<xsd:simpleType name="sKurtaxortId">
	<!-- von uns gelieferter Wertebereich -->
		<xsd:restriction base="xsd:long"/>
	</xsd:simpleType>

	<xsd:simpleType name="sFremdObjektNummer">
	<!-- evtl. eindeutiger Objektidentifier von Fremdsystemen 
  HK23.10.2007 wird wahr scheinlich verworfen und durch sBetriebsschluessel verwendet-->
		<xsd:restriction base="xsd:string"/>
	</xsd:simpleType>
	
	<xsd:simpleType name="sObjektArtId">
	<!-- gemappter Tabellenwert  -->
		<xsd:restriction base="xsd:long"/>
	</xsd:simpleType>

	<xsd:simpleType name="sBettenanzahl">
		<xsd:restriction base="xsd:int"/>
	</xsd:simpleType>
	
	<xsd:simpleType name="sSonderkennungId">
	<!-- All-Inkl.-Kennung -->
		<xsd:restriction base="xsd:long"/>
	</xsd:simpleType>

	<xsd:simpleType name="sBetriebsNummer">
	<!--Von der Gemeinde vergebene Betriebsnummer; Sollte systemuebergreifend eindeutiger Schluessel sein-->
		<xsd:restriction base="xsd:string">
			<xsd:minLength value="1"/>
		</xsd:restriction>
	</xsd:simpleType>
	
	<xsd:simpleType name="sGeburtsdatum">
		<xsd:restriction base="xsd:date"/>
	</xsd:simpleType>
	
	<xsd:simpleType name="sKategorie">
		<xsd:restriction base="xsd:int">
			<xsd:minInclusive value="0"/>
			<xsd:maxInclusive value="9"/>
		</xsd:restriction>
	</xsd:simpleType>

	<xsd:simpleType name="sKategorieId">
	<!-- Erwachsener, Kind ... Berechnungsparameter fuer Meldescheinbetrag -->
		<xsd:restriction base="xsd:int"/>
	</xsd:simpleType>
	
	<xsd:simpleType name="sAnreise">
	<!-- Berechnungsparameter fuer Meldescheinbetrag -->
		<xsd:restriction base="xsd:date"/>
	</xsd:simpleType>
	<xsd:simpleType name="sAbreise">
	<!-- Berechnungsparameter fuer Meldescheinbetrag -->
		<xsd:restriction base="xsd:date"/>
	</xsd:simpleType>
	
	<xsd:simpleType name="sVermittlerKz">
	<!-- 0: kein vermitteltes Objekt; 1: vermitteltes Objekt -->
		<xsd:restriction base="xsd:int">
			<xsd:minInclusive value="0"/>
			<xsd:maxInclusive value="1"/>
		</xsd:restriction>
	</xsd:simpleType>

	<xsd:simpleType name="sBenutzerId">
	<!-- Benutzerid, wird bei der Identifikation uebertragen -->
		<xsd:restriction base="xsd:long"/>
	</xsd:simpleType>

	<xsd:simpleType name="sKennung">
	<!-- Benutzername -->
		<xsd:restriction base="xsd:string"/>
	</xsd:simpleType>

	<xsd:simpleType name="sPasswort">
	<!-- Passwort des Benutzers -->
		<xsd:restriction base="xsd:string"/>
	</xsd:simpleType>

	<xsd:simpleType name="sAnwenderKz">
	<!-- Berechtigungen des Benutzers -->
		<xsd:restriction base="xsd:int">
			<xsd:enumeration value="1"/><!-- Gemeinde-Admin -->
			<xsd:enumeration value="2"/><!-- Gemeinde-Mitarbeiter -->
			<xsd:enumeration value="3"/><!-- Hotel-Admin -->
			<xsd:enumeration value="4"/><!-- Hotel-Mitarbeiter -->
		</xsd:restriction>
	</xsd:simpleType>

	<xsd:simpleType name="sJahreskurkarte">
	<!-- Meldeschein-Typ -->
		<xsd:restriction base="xsd:integer">
          <xsd:minInclusive value="1"/>
          <xsd:maxInclusive value="1"/>
        </xsd:restriction>
	</xsd:simpleType>

	<xsd:simpleType name="sHerkunftsId">
	<!-- Fuer mobile Meldescheinerfassung -->
		<xsd:restriction base="xsd:string">
		  <xsd:minLength value="1"/>
		  <xsd:maxLength value="255"/>
		</xsd:restriction>
	</xsd:simpleType>
	
	<xsd:simpleType name="sBenutzer">
		<xsd:restriction base="xsd:string">
		<xsd:maxLength value="10"/>
		</xsd:restriction>
	</xsd:simpleType>
	
	<xsd:simpleType name="sMsnr">
	<!-- wird vom Meldeschein-System vergeben -->
		<xsd:restriction base="xsd:string"/>
	</xsd:simpleType>

	<xsd:simpleType name="sBuchungsnummer">
	<!-- Meldescheinnummer des Fremdsystems -->
		<xsd:restriction base="xsd:string">
		<xsd:maxLength value="50"/>
		</xsd:restriction>
	</xsd:simpleType>
	
	<xsd:simpleType name="sAusweisnummer">
		<xsd:restriction base="xsd:string">	
    <xsd:maxLength value="50"/>
		</xsd:restriction>
	</xsd:simpleType>

	<xsd:simpleType name="sFirmaid">
	<!-- Firmaid im Meldescheinsystem -->
		<xsd:restriction base="xsd:long"/>
	</xsd:simpleType>

	<xsd:simpleType name="sObjektid">
	<!-- Objektid im Meldescheinsystem -->
		<xsd:restriction base="xsd:long"/>
	</xsd:simpleType>

	<xsd:simpleType name="sObjektidInt">
	<!-- Objektid im Meldescheinsystem -->
		<xsd:restriction base="xsd:integer"/>
	</xsd:simpleType>

	<xsd:simpleType name="sBetrag">
	<!-- berechneter Meldescheinbetrag im Meldescheinsystem -->
		<xsd:restriction base="xsd:decimal"/>
	</xsd:simpleType>

	<xsd:simpleType name="sAbrechnungstatusId">
		<xsd:restriction base="xsd:long"/>
	</xsd:simpleType>

	<xsd:simpleType name="sFCode">
	<!-- Fehlercode -->
		<xsd:restriction base="xsd:string">
			<xsd:maxLength value="10"/>
		</xsd:restriction>
	</xsd:simpleType>

	<xsd:simpleType name="sKurverwaltung">
	<!-- MandantId / Id der Kurverwaltung. 
		todo: im Moment vorgegebener Wertebereich (->Sicherheit) -->
		<xsd:restriction base="xsd:string">
		</xsd:restriction>
	</xsd:simpleType>
	
	<xsd:simpleType name="sSchnittstelle">
	<!-- Schnittstellen-Bezeichnung. Fuer Log-Aktiviataeten -->
		<xsd:restriction base="xsd:string"/>
	</xsd:simpleType>
	<xsd:simpleType name="sVerarbeitung">
		<xsd:restriction base="xsd:string">
		<!--
			<xsd:enumeration value="STAMM"/>
			<xsd:enumeration value="BUCHEN"/>
			<xsd:enumeration value="BENUTZER"/>
			<xsd:enumeration value="KURTAXLISTEN"/>
			<xsd:enumeration value="FIRMENBETRIEBSARTEN"/>
			<xsd:enumeration value="CHECK_FIRMA_UPD_MANMS"/>
			<xsd:enumeration value="CHECK_OBJEKT_UPD_KTXORT"/>
			<xsd:enumeration value="CHECK_OBJEKT_UPD_KTXZONE"/>
			<xsd:enumeration value="BETRIEBSARTEN-F"/>
			<xsd:enumeration value="BETRIEBSARTEN-O"/>
		-->
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="sVersion">
		<xsd:restriction base="xsd:string">
			<xsd:maxLength value="10"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="sPersonId">
		<!-- gemappter Tabellenwert -->
		<xsd:restriction base="xsd:integer"/>
	</xsd:simpleType>
	<xsd:simpleType name="sParameter">
		<!-- gemappter Tabellenwert -->
		<xsd:restriction base="xsd:string"/>
	</xsd:simpleType>
	<xsd:simpleType name="sBarcode">
		<xsd:restriction base="xsd:string"/>
	</xsd:simpleType>
	<xsd:simpleType name="sLandISO">
		<xsd:restriction base="xsd:string"/>
	</xsd:simpleType>
	<xsd:simpleType name="sLandId">
		<xsd:restriction base="xsd:integer"/>
	</xsd:simpleType>
	<xsd:simpleType name="sAnredeId">
		<xsd:restriction base="xsd:integer"/>
	</xsd:simpleType>
	<xsd:simpleType name="sExportId">
		<xsd:restriction base="xsd:integer"/>
	</xsd:simpleType>
	<xsd:complexType name="cLand">
	    <!-- Land  -->
	    <xsd:sequence>
	        <xsd:element name="land-id" type="ms:sLandId" minOccurs="0"/>
	        <xsd:element name="land-iso" type="ms:sLandISO" minOccurs="0"/>
	    </xsd:sequence>
	</xsd:complexType>
	<!--
	<xsd:complexType name="cAnrede">
	    
	    <xsd:choice>
	        <xsd:element name="anrede-id" type="ms:sAnredeId"/>
	        <xsd:element name="anrede" type="ms:string"/>
	    </xsd:choice>
	</xsd:complexType>
	-->
	<xsd:complexType name="cPerson">
	    <!-- Personen fuer Export zu  -->
	    <xsd:sequence>
	        <xsd:element minOccurs="0" name="personid" type="ms:sPersonId"/>
	        <xsd:element minOccurs="1" name="adresse" type="ms:cAdresse"/>
	        <xsd:element minOccurs="0" name="geburtsdatum" type="ms:sGeburtsdatum"/>
	        <xsd:element minOccurs="0" name="staatsangehoerigkeitid" type="ms:cLand"/>
	        <xsd:element name="kategorieid" type="ms:sKategorieId"/><!-- Berechnungs-Parameter -->
	        <xsd:element minOccurs="0" name="anreise" type="ms:sAnreise"/><!-- Berechnungs-Parameter -->
	        <xsd:element minOccurs="0" name="abreise" type="ms:sAbreise"/><!-- Berechnungs-Parameter -->
	        <xsd:element name="barcode" type="ms:sBarcode" minOccurs="0"/>
	    </xsd:sequence>
	</xsd:complexType>
	<xsd:complexType name="cMeldeschein">
	    <xsd:sequence>
	        <xsd:element name="ort-id" type="ms:sOrtId"/>
	        <xsd:element name="buchungsnummer" type="ms:sBuchungsnummer"/><!-- Meldeschein-Nummer des Fremdsystems  -->
	        <xsd:element minOccurs="0" name="meldescheinnummer" type="ms:sMsnr"/><!-- wird vom Meldeschein-System vergeben -->
	        <xsd:element name="firmaid" type="ms:sFirmaid" minOccurs="1" nillable="true"/><!-- Firma-Id, ueber diese wird der Bezug zur Firma hergestellt -->
	        <xsd:element name="objektid" type="ms:sObjektid" minOccurs="1" nillable="false"/><!-- Objekt-Id, ueber diese wird der Bezug zum Objekt hergestellt --><!-- Berechnungs-Parameter --><!-- Berechnungs-Parameter --><!-- Berechnungs-Parameter --><!-- gemappter Tabellenwert --><!-- gemappter Tabellenwert --><!-- gemappter Tabellenwert -->
	        <xsd:element minOccurs="1" maxOccurs="1" name="hauptperson" type="ms:cPerson"/>
	        <xsd:element minOccurs="0" name="weitere_angaben" type="ms:sAusweisnummer"><!-- entspricht der Ausweisnummer, nur Ziffern erlaubt --></xsd:element>
	        <xsd:element minOccurs="0" name="kfzkennzeichen" type="xsd:string"/>
	        <xsd:element minOccurs="0" name="betrag" type="ms:sBetrag"/><!-- wird vom Meldeschein-System berechnet und zurueckgegeben -->
	        <xsd:element name="abrechnungstatusid" type="ms:sAbrechnungstatusId" minOccurs="0"/><!-- todo: klaeren, ob notwendig -->
	        <xsd:element name="zusatzfelder" type="ms:cMeldescheinZusatzfelder" minOccurs="0"/>
	        <xsd:choice>
	            <xsd:element minOccurs="0" maxOccurs="unbounded" name="begleitperson" type="ms:cPerson"/>
	            <xsd:element name="begleitgruppe" type="ms:cBegleitgruppe" maxOccurs="unbounded" minOccurs="0"/>
	        </xsd:choice>
	        <xsd:element name="export-id" type="ms:sExportId" minOccurs="0"/>
	    </xsd:sequence>
	</xsd:complexType>
	<xsd:simpleType name="sOrtId">
	    <!-- MandantId / Id der Kurverwaltung. 
		todo: im Moment vorgegebener Wertebereich (->Sicherheit) -->
	    <xsd:restriction base="xsd:integer">
	    </xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="sBinaerdaten">
		<!-- wird vom Meldeschein-System vergeben -->
		<xsd:restriction base="xsd:base64Binary"/>
	</xsd:simpleType>
	<xsd:complexType name="cMeldescheinRegister">
		<xsd:sequence>
			<xsd:element name="ort-id" type="ms:sOrtId" minOccurs="1"/>
			<xsd:element minOccurs="1" name="meldescheinnummer" type="ms:sMsnr"/><!-- Meldeschein-Nummer des Fremdsystems  --><!-- wird vom Meldeschein-System vergeben -->			
		</xsd:sequence>
	</xsd:complexType>
	<xsd:complexType name="cMeldescheinZusatzfelder" abstract="false">
		<xsd:sequence>
			<xsd:element name="sb-versorgungsamtnr" type="xsd:string" minOccurs="0"/>
			<xsd:element minOccurs="0" name="sb-gueltig-bis" type="xsd:date"/><!-- Meldeschein-Nummer des Fremdsystems  --><!-- wird vom Meldeschein-System vergeben -->
			<xsd:element minOccurs="0" name="freie-tage" type="xsd:integer"/>
                        <xsd:element name="firmenname" type="xsd:string" minOccurs="0"/>
                        <xsd:element name="taetigkeitsort" type="xsd:string" minOccurs="0"/>
		</xsd:sequence>
	</xsd:complexType>
</xsd:schema>