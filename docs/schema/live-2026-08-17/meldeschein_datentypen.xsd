<?xml version='1.0' encoding='UTF-8'?><!-- Published by JAX-WS RI (http://jax-ws.java.net). RI's version is JAX-WS RI 2.3.0-wls122140-b190328.0053 svn-revision#unknown. --><xsd:schema xmlns:ms="http://www.avs.meldeschein.de/ns/" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:avs="http://www.avs.de/ns/" targetNamespace="http://www.avs.meldeschein.de/ns/">
	<xsd:complexType name="cObjekt">
		<xsd:sequence>
			<!-- Beherbergunsbetrieb -->
			<xsd:element name="objektid" type="ms:sObjektid" minOccurs="0" nillable="false"/>
			<xsd:element maxOccurs="1" minOccurs="1" name="bezeichnung" type="ms:sBezeichnung"/>
			<xsd:element maxOccurs="1" minOccurs="0" name="betriebsschluessel" type="ms:sBetriebsschluessel"/>
			<xsd:element maxOccurs="1" minOccurs="1" name="kurtaxzoneid" type="ms:sKurtaxzoneId"/><!-- von uns gelieferter Wertebereich -->
			<xsd:element maxOccurs="1" minOccurs="1" name="kurtaxortid" type="ms:sKurtaxortId"/><!-- von uns gelieferter Wertebereich -->
			<xsd:element maxOccurs="1" minOccurs="1" name="objektartid" type="ms:sObjektArtId"/><!-- gemappter Tabellenwert -->
			<xsd:element maxOccurs="1" minOccurs="0" name="sonderkennungid" type="ms:sSonderkennungId"/><!-- Hotel-Id des Fremdsystems -->
			<xsd:element maxOccurs="1" minOccurs="0" name="bettenanzahl" type="ms:sBettenanzahl"/>
			<xsd:element minOccurs="1" maxOccurs="unbounded" name="adresse" type="ms:cAdresse"/>
			<xsd:element name="rechnung_immer_eigentuemer" type="xsd:boolean" minOccurs="0"/>
		</xsd:sequence>
	</xsd:complexType>
	
	<xsd:complexType name="cBegleitperson">
		<!-- Begleitpersonen beim Buchen eines Meldescheins -->
		<xsd:sequence>
			<xsd:element minOccurs="0" name="personid" type="ms:sPersonId"/>
			<xsd:element minOccurs="0" name="anredeid" type="ms:sAnredeId"/>
			<xsd:element name="name" type="ms:sName"/>
			<xsd:element minOccurs="0" name="vorname" type="ms:sName"/>
			<xsd:element minOccurs="0" name="geburtsdatum" type="ms:sGeburtsdatum"/>
			<xsd:element name="kategorieid" type="ms:sKategorieId"/><!-- Berechnungs-Parameter -->
			<xsd:element minOccurs="0" name="anreise" type="ms:sAnreise"/><!-- Berechnungs-Parameter -->
			<xsd:element minOccurs="0" name="abreise" type="ms:sAbreise"/><!-- Berechnungs-Parameter -->
      <xsd:element minOccurs="0" name="staatsangehoerigkeitid" type="xsd:long"/><!-- gemappter Tabellenwert -->
  		<xsd:element name="staatsangehoerigkeit" type="ms:cLand" minOccurs="0"/>
      <xsd:element minOccurs="0" name="ausweisnr" type="xsd:string"/>
			<xsd:element name="barcode" type="ms:sBarcode" minOccurs="0"/>
			<xsd:element minOccurs="0" name="betrag" type="ms:sBetrag"/>
                        <xsd:element name="email" type="xsd:string" minOccurs="0"/>
                        <xsd:element name="digit_gastkart" type="xsd:boolean" minOccurs="0"/>
		</xsd:sequence>
	</xsd:complexType>

	<xsd:complexType name="cBegleitgruppe">
		<!-- Begleitpersonen beim Buchen eines Gruppen-Meldescheins -->
		<xsd:sequence>
			<xsd:element minOccurs="0" name="personid" type="ms:sPersonId"/>
			<xsd:element name="kategorieid" type="ms:sKategorieId"/><!-- Berechnungs-Parameter -->
			<xsd:element name="anzahl" type="xsd:int"/><!-- Berechnungs-Parameter -->
			<xsd:element minOccurs="0" name="betrag" type="ms:sBetrag"/>
      <xsd:element minOccurs="0" name="ausweisnr" type="xsd:string"/>
		</xsd:sequence>
	</xsd:complexType>
	
	<xsd:complexType name="cBenutzer">
		<!-- Benutzer im JMeldeschein-System -> Berechtigungen -->
		<xsd:sequence>
			<xsd:element name="benutzerid" type="xsd:long"/><!-- Id des Fremdsystems -->
			<xsd:element name="kennung" type="ms:sKennung"/>
			<xsd:element name="passwort" type="ms:sPasswort"/>
			<xsd:element maxOccurs="1" minOccurs="1" name="firmenbetriebsnummer" type="ms:sBetriebsNummer"/><!-- Benutzer darf nur unter dieser Firma 'arbeiten' -->
			<xsd:element maxOccurs="1" minOccurs="1" name="anwenderkz" type="ms:sAnwenderKz"/><!-- Admin- oder Mitarbeiterrechte (siehe Datentyp) -->
		</xsd:sequence>
	</xsd:complexType>
	
	<xsd:complexType name="cAdresse">
		<xsd:sequence>
			<xsd:element minOccurs="0" name="firmenadressname" type="ms:sFirmenname">
				<!-- wird auf der Rechnung ueber der Anschrift angedruckt -->
			</xsd:element>
			<xsd:element minOccurs="1" name="adressartid" type="ms:sAdressArtId" maxOccurs="1"><!-- gemappter Tabellenwert --></xsd:element>
			<xsd:element minOccurs="0" name="anredeid" type="ms:sAnredeId"><!-- gemappter Tabellenwert --></xsd:element>
			<xsd:element name="anrede" type="ms:sAnrede" minOccurs="0"/>
			<xsd:element maxOccurs="1" minOccurs="0" name="titel" type="ms:sTitel"/>
			<xsd:element minOccurs="0" name="vorname" type="ms:sName"/>
			<xsd:element minOccurs="0" name="name" type="ms:sName" maxOccurs="1"/>
			<xsd:element minOccurs="0" name="strasse" type="ms:sStrasse"/>
			<xsd:element minOccurs="0" name="hausnummer" type="ms:sHausnummer"/>
			<xsd:element minOccurs="0" name="plz" type="ms:sPlz"/>
			<xsd:element minOccurs="0" name="ort" type="ms:sOrt"/>
			<xsd:element name="land" type="ms:cLand" minOccurs="0"/>
		</xsd:sequence>
	</xsd:complexType>

	<xsd:complexType name="cKommunikation">
		<xsd:sequence>
			<!-- Kommunikation  -->
			<xsd:element maxOccurs="1" minOccurs="1" name="anschlusstypid" type="ms:sAnschlussTypId"><!-- todo: klaeren, ob gemappter Tabellenwert oder von uns gelieferter Wertebereich--></xsd:element>
			<xsd:element minOccurs="0" name="anschlusskennung" type="ms:sAnschlusskennung"><!-- Telefonnummer, Email-Adresse etc. --></xsd:element>
		</xsd:sequence>
	</xsd:complexType>

	<xsd:complexType name="cBankverbindung">
		<xsd:sequence>
			<!-- Bankverbindung  -->
			<xsd:element minOccurs="0" name="zahlartid" type="ms:sZahlartId">
				<!-- wird beim Rechnungsdruck beachtet : Ueberweisung oder Bankeinzug -->
			</xsd:element>
			<xsd:element minOccurs="0" name="bankverbindung" type="ms:sBankverbindung"/>
			<xsd:element minOccurs="0" name="kontonummer" type="ms:sKontonummer"/>
			<xsd:element minOccurs="0" name="bankleitzahl" type="ms:sBankleitzahl"/>
			<xsd:element minOccurs="0" name="kontoinhaber" type="ms:sKontoinhaber"/>
		</xsd:sequence>
	</xsd:complexType>

	<xsd:complexType name="cKurtaxzone">
		<!-- von uns gelieferter Wertebereich -->
		<xsd:sequence>
			<xsd:element name="kurtaxzoneid" type="ms:sKurtaxzoneId"/>
			<xsd:element name="bezeichnung" type="xsd:string"/>
		</xsd:sequence>
	</xsd:complexType>

	<xsd:complexType name="cKurtaxort">
		<!-- von uns gelieferter Wertebereich -->
		<xsd:sequence>
			<xsd:element name="kurtaxortid" type="ms:sKurtaxortId"/>
			<xsd:element name="bezeichnung" type="xsd:string"/>
		</xsd:sequence>
	</xsd:complexType>

	<xsd:complexType name="cBetriebsart">		
		<!-- Firmenbetriebsarten: von uns gelieferter Wertebereich -->
		<xsd:sequence>
			<xsd:element name="betriebsartid" type="ms:sBetriebsartId"/>
			<xsd:element name="bezeichnung" type="xsd:string"/>
		</xsd:sequence>
	</xsd:complexType>	
        
        <!-- Individuelle Zusatzfelder -->
        <xsd:complexType name="cIndivZusatzfelder">
            <xsd:sequence>
                <xsd:element name="feld" type="xsd:string"/>
                <xsd:element name="wert" type="xsd:string"/>
            </xsd:sequence>
        </xsd:complexType>
        

	<xsd:complexType name="cFehlermeldungen">
	<!-- Fehlermeldungsblock, mit Fehlercode und -beschreibung. Wird kein Fehler zurueckgegeben, wird ein Eintrag mit dem Fehlercode 10001 eingetragen -->
		<xsd:sequence maxOccurs="1" minOccurs="0">
			<xsd:element name="fehler" minOccurs="0" maxOccurs="unbounded">
				<xsd:complexType>
					<xsd:sequence>
						<xsd:element name="code" type="ms:sFCode"/>
						<xsd:element name="beschreibung" type="xsd:string"/>
						<xsd:element name="bezug" type="xsd:string" minOccurs="0"/>
					</xsd:sequence>
				</xsd:complexType>
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>

	<xsd:complexType name="cIdentifikation">
	<!-- Identifikation, die jedem Webservice-Aufruf voran steht. 
		todo: noch nicht endgueltige Definition -->
		<xsd:sequence>
			<xsd:element name="erzeugung" type="xsd:date"/>
			<xsd:element name="schnittstelle" type="ms:sSchnittstelle"/>
			<xsd:element name="kurverwaltung" type="ms:sKurverwaltung"/>
			<xsd:element name="benutzerid" type="xsd:long" minOccurs="0"/>
			<xsd:element name="sessionid" type="xsd:string" minOccurs="0"/>
			<xsd:element name="verarbeitung" type="ms:sVerarbeitung" minOccurs="1"/>
			<xsd:element name="version" type="ms:sVersion" minOccurs="0"/>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:complexType name="cKonfigurationsdatensatz">
		<xsd:sequence>
			<xsd:element name="id" type="xsd:integer" minOccurs="1" maxOccurs="1"/>
			<xsd:element name="text1" type="xsd:string" maxOccurs="1"/>
			<xsd:element name="text2" type="xsd:string" minOccurs="0" maxOccurs="1"/>
   <xsd:element name="text3" type="xsd:string" minOccurs="0" maxOccurs="1"/>
  </xsd:sequence>
	</xsd:complexType>
	<xsd:complexType name="cKonfigurationsliste">
		<xsd:sequence>
			<xsd:element name="konfigdatensatz" type="ms:cKonfigurationsdatensatz" minOccurs="1" maxOccurs="unbounded"/>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:complexType name="cParameter">
		<xsd:sequence>
			<xsd:element name="param" type="ms:sParameter" minOccurs="1" maxOccurs="unbounded"/>
		</xsd:sequence>
	</xsd:complexType>

	<xsd:simpleType name="sBetriebsschluessel">
	<!-- Von der Gemeinde vergebener Betriebsschluessel -->
		<xsd:restriction base="xsd:string">
			<xsd:minLength value="1"/>
			<xsd:maxLength value="4"/>
			<xsd:pattern value="[0-9]*"/>
		</xsd:restriction>
	</xsd:simpleType>

	<xsd:simpleType name="sBetriebsartId">
	<!-- Typ des Betriebes Campingplatz/Hotel usw -->
		<xsd:restriction base="xsd:long">
			<xsd:minInclusive value="1"/>
			<xsd:maxInclusive value="16"/>
		</xsd:restriction>
	</xsd:simpleType>

	<xsd:simpleType name="sManuellerMeldschein">
	<!-- elektronische oder manuelle Anlage der Meldescheine  -->
		<xsd:restriction base="xsd:boolean"/>
	</xsd:simpleType>

	<xsd:simpleType name="sAufwandsentschaedigung">
	<!-- Prozentsatz, den das Hotel vom Meldescheinbetrag gutgeschrieben bekommt -->
		<xsd:restriction base="xsd:decimal"/>
	</xsd:simpleType>

	<xsd:simpleType name="sSteuernummer">
	<!-- Vom Finanzamt vergebene Steuernummer -->
		<xsd:restriction base="xsd:string">
			<xsd:maxLength value="20"/>
		</xsd:restriction>
	</xsd:simpleType>

	<xsd:simpleType name="sUmsatzsteuerIdNummer">
	<!-- Umsatzsteuer IdNr. -->
		<xsd:restriction base="xsd:string">
			<xsd:maxLength value="20"/>
		</xsd:restriction>
	</xsd:simpleType>

	<xsd:simpleType name="sFirmenname">
	<!-- Firmenname fuer Rechnung -->
		<xsd:restriction base="xsd:string">
			<xsd:maxLength value="255"/>
		</xsd:restriction>
	</xsd:simpleType>

	<xsd:simpleType name="sAdressArtId">
	<!-- Art der Adresse Rechnung/privat : gemappter Tabellenwert -->
		<xsd:restriction base="xsd:long">
			<xsd:minInclusive value="1"/>
			<xsd:maxInclusive value="5"/>
		</xsd:restriction>
	</xsd:simpleType>

	<!-- Alt, wir steigen um auf Class Integer 
	<xsd:simpleType name="sAnredeId">
		<xsd:restriction base="xsd:long"></xsd:restriction>
	</xsd:simpleType>
	-->
	<xsd:simpleType name="sAnrede">
	<!-- direkte Angabe der Anrede, beschraenkt auf Herr und Frau (und Leereintrag) -->
